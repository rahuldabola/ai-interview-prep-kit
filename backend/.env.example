# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas (or any Mongo instance). Not required to run `npm run evaluate`.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/interview-prep-kit

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# LLM provider: Google Gemini (https://aistudio.google.com/apikey — free tier)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# Retrieval safety. Set to "true" only for local development/batch testing against
# fixture sites on localhost (see Section 9 of the brief). Must be unset/false in production.
ALLOW_PRIVATE_HOSTS=false

# Bound on LLM requests-in-flight at once, to stay under free-tier tokens-per-minute limits.
LLM_MAX_CONCURRENCY=1
